# Use :80 for IP-only HTTP access or a domain for automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Docker image and runtime settings.
# APP_IMAGE is the ACR registry address. deploy/publish.sh builds and pushes
# the image from your local machine; the server only pulls it, never builds.
APP_IMAGE=registry.cn-hangzhou.aliyuncs.com/your-namespace/zhishen-evolution
IMAGE_TAG=latest
TZ=Asia/Shanghai

# Optional OpenAI-compatible model for credit assessment interpretation.
# Defaults target Kimi (Moonshot); any OpenAI-compatible provider works.
# Leave LLM_API_KEY empty to use the built-in rule-based interpretation.
LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.cn/v1
# Kimi models: thinking mode is disabled in code for this short task;
# kimi-k2.6 then requires temperature=0.6 (thinking mode would require 1).
# Other providers (e.g. DeepSeek) accept lower values like 0.35.
LLM_MODEL=kimi-k2.6
# Optional backup provider (e.g. DeepSeek: https://api.deepseek.com + deepseek-chat).
# Used automatically when the primary request fails.
LLM_BACKUP_API_KEY=
LLM_BACKUP_BASE_URL=
LLM_BACKUP_MODEL=
LLM_TIMEOUT_MS=12000
LLM_TEMPERATURE=0.6
LLM_RATE_LIMIT_MAX=5
LLM_RATE_LIMIT_WINDOW_MS=600000
