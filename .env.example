# Use :80 for IP-only HTTP access or a domain for automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Docker image and runtime settings.
APP_IMAGE=zhishen-evolution
IMAGE_TAG=local
TZ=Asia/Shanghai

# Optional OpenAI-compatible model for credit assessment interpretation.
# Leave all three empty to use the built-in rule-based interpretation.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=12000
LLM_RATE_LIMIT_MAX=5
LLM_RATE_LIMIT_WINDOW_MS=600000
